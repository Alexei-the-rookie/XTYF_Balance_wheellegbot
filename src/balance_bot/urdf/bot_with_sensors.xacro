<?xml version="1.0"?>
<robot name="wheel_leg_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 包含基础模型 -->
  <xacro:include filename="$(find balance_bot)/urdf/wheel_leg_initial_pose.xacro" />

  <!-- 添加IMU传感器插件 -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose> <!-- Ensure sensor frame aligns with body frame (Y axis is Pitch, matching Hip axis) -->
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <!-- Gazebo内部发布IMU数据的话题，桥接会连接到这里 -->
      <topic>/imu</topic>
      <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu">
        <!-- 注意：这里的是插件内部参数，与你上面的<imu>标签是两套东西。
             下面的噪声配置是为插件准备的，格式也不同。-->
        <topic>/imu</topic>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.0002</stddev>
        </noise>
        <!-- 为了快速验证，你可以先注释掉下面详细的噪声配置，
             等传感器能工作后再来细化。 -->
        <!--
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
        -->
      </plugin>
    </sensor>
  </gazebo>
  <!-- Legacy IMU plugin removed -->

  <!-- 里程计插件 (已注释，避免与 customized force control 冲突)
  <gazebo>
    <plugin filename="libgz_sim_diff_drive_system.so" name="gz::sim::systems::DiffDrive">
      <ros>
        <namespace>/wheel_leg_robot</namespace>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <command_topic>/cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
  -->

</robot>