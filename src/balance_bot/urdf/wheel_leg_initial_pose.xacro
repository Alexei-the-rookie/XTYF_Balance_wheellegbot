<?xml version="1.0"?>
<robot name="wheel_leg_initial_pose" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 包含宏定义 -->
  <xacro:include filename="$(find balance_bot)/urdf/leg_initial_pose_module.xacro" />

  <!-- 定义机器人参数 -->
  <xacro:property name="body_length" value="0.4" />
  <xacro:property name="body_width" value="0.35" /> <!-- Width 0.35 implies half-width 0.175 -->
  <xacro:property name="body_height" value="0.15" />

  <!-- 机器人主体 -->
  <link name="base_link">
    <!-- Body Parameters as per user request:
         Mass: 15.0 kg
         CoM: 0.0 0.0 0.05 m
         Inertia (Pitch): 0.1125 kg*m^2
         Inertia (Yaw): 0.05 kg*m^2
    -->
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <!-- Pitch (y-axis) = 0.1125, Yaw (z-axis) = 0.05. Estimating Roll (x-axis) ~ 0.1 -->
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1125" iyz="0.0" izz="0.05"/>
      <!-- COM distance from hip axis is 0.05 -->
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- 添加左侧腿 -->
  <xacro:leg_initial_pose_module
    prefix="left"
    parent="base_link"
    x="${0}"
    y="${body_width/2}"
    z="0"
    mirror="false" />

  <!-- 添加右侧腿 -->
  <xacro:leg_initial_pose_module
    prefix="right"
    parent="base_link"
    x="${0}"
    y="${-body_width/2}"
    z="0"
    mirror="true" />

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Left Leg -->
    <joint name="left_hip_joint">
      <command_interface name="effort">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_knee_joint">
      <command_interface name="effort">
        <param name="min">-25</param>
        <param name="max">25</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_wheel_joint">
      <command_interface name="effort">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- Right Leg -->
    <joint name="right_hip_joint">
      <command_interface name="effort">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_knee_joint">
      <command_interface name="effort">
        <param name="min">-25</param>
        <param name="max">25</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="effort">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo插件 -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Gazebo ROS控制插件 -->
  <gazebo>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(find balance_bot)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>